<div class="pm-shell" data-pm-theme="dark"><g:render template="/shared/pmStyles"/><g:render template="/shared/pmSidebar"/><div class="pm-main"><g:render template="/shared/pmHeader"/><main class="pm-content"><main class="cm"><nav class="cm-nav"><a class="cm-tab" href="${g.createLink(controller:'changeManagement', action:'index', params:[tab:'dcn'])}">DCN</a><a class="cm-tab" href="${g.createLink(controller:'changeManagement', action:'index', params:[tab:'projects'])}">Projects</a><a class="cm-tab" href="${g.createLink(controller:'changeManagement', action:'index', params:[tab:'createDcn'])}">Create DCN</a></nav><g:if test="${flash.error}"><p class="error">${flash.error.encodeAsHTML()}</p></g:if>
<g:if test="${tab == 'createDcn'}"><section class="cm-create-dcn"><h2>Create DCN</h2><g:if test="${request.isUserInRole('ROLE_ADMIN')}"><form method="post" action="${g.createLink(controller:'changeManagement', action:'createDcn')}"><label>Open Project <select name="projectId" required><g:each in="${openProjects}" var="p"><option value="${p.id}">${p.projectNumber.encodeAsHTML()} — ${p.title.encodeAsHTML()}</option></g:each></select></label><label>Title <input name="title" required/></label><label>Description <textarea name="description" rows="4"></textarea></label><label>Planned Release Date <input type="date" name="plannedReleaseDate"/></label><button class="btn">Create DCN</button></form></g:if></section></g:if>
<g:if test="${tab == 'projects'}"><section><h2>Projects</h2><a href="${g.createLink(controller:'changeManagement', action:'index', params:[tab:'projects'])}&amp;status=ALL">All</a> | <a href="${g.createLink(controller:'changeManagement', action:'index', params:[tab:'projects'])}&amp;status=OPEN">Open</a> | <a href="${g.createLink(controller:'changeManagement', action:'index', params:[tab:'projects'])}&amp;status=CLOSED">Closed</a><div class="table-wrap"><table><thead><tr><th>Project</th><th>Title</th><th>Status</th><th>Start of Production</th><th></th></tr></thead><tbody><g:each in="${projects}" var="p"><tr><td>${p.projectNumber.encodeAsHTML()}</td><td>${p.title.encodeAsHTML()}</td><td>${p.status}</td><td><g:formatDate date="${p.startOfProduction}" format="yyyy-MM-dd"/></td><td><a href="${g.createLink(controller:'changeManagement', action:'project', id:p.id)}" class="btn">Open Project</a></td></tr></g:each></tbody></table></div><g:if test="${request.isUserInRole('ROLE_ADMIN')}"><h3>Create Project</h3><form method="post" action="${g.createLink(controller:'changeManagement', action:'createProject')}"><label>Project Number <input name="projectNumber" required/></label><label>Title <input name="title" required/></label><label>Description <textarea name="description" rows="3"></textarea></label><label>Start of Production <input type="date" name="startOfProduction"/></label><button class="btn">Create Project</button></form></g:if></section></g:if>
<g:if test="${tab != 'projects' && tab != 'createDcn'}"><section><h2>Design Change Notices</h2><div class="table-wrap"><table><thead><tr><th>DCN</th><th>Project</th><th>Title</th><th>Release Status</th><th>Planned Release</th><th></th></tr></thead><tbody><g:each in="${dcns}" var="d"><tr><td>${d.dcnNumber.encodeAsHTML()}</td><td>${d.project.projectNumber.encodeAsHTML()}</td><td>${d.title.encodeAsHTML()}</td><td>${d.status}</td><td><g:formatDate date="${d.plannedReleaseDate}" format="yyyy-MM-dd"/></td><td><a href="${g.createLink(controller:'changeManagement', action:'dcn', id:d.id)}" class="btn">Open DCN</a></td></tr></g:each></tbody></table></div></section></g:if></main></main></div><g:render template="/shared/pmScript"/></div>