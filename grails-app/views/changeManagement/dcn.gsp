<div class="pm-shell" data-pm-theme="dark"><g:render template="/shared/pmShellStyles"/><g:render template="/shared/pmShellSidebar"/><div class="pm-main"><g:render template="/shared/pmShellHeader" model="[moduleTitle: 'Change Management']"/><main class="pm-content"><main class="cm"><g:render template="/changeManagement/dcnLayout"/><nav class="cm-nav"><a href="${request.contextPath}/changeManagement/index">DCN</a><a href="${request.contextPath}/changeManagement/project/${dcn.project.id}">Project ${dcn.project.projectNumber.encodeAsHTML()}</a></nav><g:if test="${flash.error}"><p class="error">${flash.error.encodeAsHTML()}</p></g:if><section class="cm-dcn-card"><div class="cm-dcn-heading"><h2>DCN — ${dcn.dcnNumber.encodeAsHTML()}</h2><span class="cm-dcn-status">${dcn.status.encodeAsHTML()}</span></div>
<g:if test="${dcn.status == 'DRAFT' && request.isUserInRole('ROLE_ADMIN')}">
<form method="post" action="${request.contextPath}/changeManagement/updateDcn/${dcn.id}" class="cm-dcn-form">
<label>Title<input name="title" maxlength="255" required class="cm-long-title" value="${dcn.title?.encodeAsHTML()}"/></label>
<label>Description<textarea name="description" rows="6" maxlength="20000" class="cm-description">${dcn.description?.encodeAsHTML()}</textarea></label>
<div class="cm-dcn-row"><label>Project<input value="${dcn.project.projectNumber.encodeAsHTML()} — ${dcn.project.title.encodeAsHTML()}" readonly/><input type="hidden" name="projectId" value="${dcn.project.id}"/></label><label>Planned Release Date<input type="date" name="plannedReleaseDate" value="${dcn.plannedReleaseDate ? g.formatDate(date:dcn.plannedReleaseDate,format:'yyyy-MM-dd') : ''}"/></label></div>
<div class="cm-dcn-actions"><button type="submit" class="btn primary">Save</button></div></form>
</g:if><g:else><div class="cm-dcn-form cm-dcn-readonly"><label>Title<div class="cm-readonly-field">${dcn.title?.encodeAsHTML()}</div></label><label>Description<div class="cm-readonly-field cm-description-display">${dcn.description?.encodeAsHTML()}</div></label><div class="cm-dcn-row"><label>Project<div class="cm-readonly-field">${dcn.project.projectNumber.encodeAsHTML()} — ${dcn.project.title.encodeAsHTML()}</div></label><label>Planned Release Date<div class="cm-readonly-field"><g:if test="${dcn.plannedReleaseDate}"><g:formatDate date="${dcn.plannedReleaseDate}" format="yyyy-MM-dd"/></g:if><g:else>—</g:else></div></label></div></div></g:else>
<div class="cm-dcn-audit"><div><strong>Issued By:</strong> ${dcn.issuedBy?.encodeAsHTML() ?: '—'}</div><div><strong>Issued Date:</strong> <g:formatDate date="${dcn.dateCreated}" format="yyyy-MM-dd HH:mm"/></div><div><strong>Approved By:</strong> ${dcn.approvedBy?.encodeAsHTML() ?: '—'}</div><div><strong>Approved Date:</strong> <g:if test="${dcn.approvedAt}"><g:formatDate date="${dcn.approvedAt}" format="yyyy-MM-dd HH:mm"/></g:if><g:else>—</g:else></div></div>
<div class="cm-dcn-workflow"><h3>Release Workflow</h3><g:if test="${request.isUserInRole('ROLE_ADMIN')}"><g:if test="${dcn.status == 'DRAFT'}"><form method="post" action="${request.contextPath}/changeManagement/transition/${dcn.id}" class="inline"><input type="hidden" name="target" value="IN_REVIEW"/><button class="btn">Submit for Review</button></form></g:if><g:if test="${dcn.status == 'IN_REVIEW'}"><form method="post" action="${request.contextPath}/changeManagement/transition/${dcn.id}" class="inline"><input type="hidden" name="target" value="DRAFT"/><button class="btn">Return to Draft</button></form><form method="post" action="${request.contextPath}/changeManagement/transition/${dcn.id}" class="inline"><input type="hidden" name="target" value="APPROVED"/><button class="btn">Approve</button></form></g:if><g:if test="${dcn.status == 'APPROVED'}"><form method="post" action="${request.contextPath}/changeManagement/transition/${dcn.id}" class="inline"><input type="hidden" name="target" value="RELEASED"/><button class="btn" onclick="return confirm('Release all connected part revisions?')">Release DCN and Parts</button></form></g:if></g:if></div>
<div class="cm-dcn-actions"><g:if test="${dcn.status in ['DRAFT','IN_REVIEW'] && request.isUserInRole('ROLE_ADMIN')}"><form method="post" action="${request.contextPath}/changeManagement/transition/${dcn.id}" class="inline" onsubmit="return confirm('Cancel this DCN? This action cannot be undone.');"><input type="hidden" name="target" value="CANCELLED"/><button class="btn cm-danger" type="submit">Cancel DCN</button></form></g:if><g:else><a class="btn" href="${request.contextPath}/changeManagement/index">Close</a></g:else></div>
</section><section>
<h2>Connected Parts</h2><div class="table-wrap"><table><tr><th>Part</th><th>Version</th><th>LOM</th><th>Lifecycle</th><th></th></tr><g:each in="${connectedParts}" var="link"><tr><td>${(link.part.label ?: link.part.id.toString()).encodeAsHTML()}</td><td>${link.majorVersion}.${link.minorVersion}</td><td>${link.part.lom ?: '—'}</td><td>${link.part.lifecycleState}</td><td><a class="btn" href="${request.contextPath}/plm/showPart/${link.part.id}">Open Part</a><g:if test="${dcn.status == 'DRAFT' && request.isUserInRole('ROLE_ADMIN')}"><form method="post" action="${request.contextPath}/changeManagement/removePart/${dcn.id}" class="inline"><input type="hidden" name="associationId" value="${link.associationId}"/><button class="btn">Remove</button></form></g:if></td></tr></g:each></table></div><g:if test="${dcn.status == 'DRAFT' && request.isUserInRole('ROLE_ADMIN')}"><h3>Add Part</h3><form method="post" action="${request.contextPath}/changeManagement/addPart/${dcn.id}"><select name="partId"><g:each in="${parts}" var="p"><option value="${p.id}">${(p.label ?: p.originalName ?: p.id.toString()).encodeAsHTML()} (#${p.id})</option></g:each></select><button class="btn">Add Part</button></form></g:if></section></main></main></div><g:render template="/shared/pmShellScript"/></div>