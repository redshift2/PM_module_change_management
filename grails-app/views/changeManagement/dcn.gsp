<div class="pm-shell" data-pm-theme="dark"><g:render template="/shared/pmStyles"/><g:render template="/shared/pmSidebar"/><div class="pm-main"><g:render template="/shared/pmHeader"/><main class="pm-content"><main class="cm"><nav class="cm-nav"><a href="${g.createLink(controller:'changeManagement', action:'index')}">DCN</a><a href="${g.createLink(controller:'changeManagement', action:'project', id:dcn.project.id)}">Project ${dcn.project.projectNumber.encodeAsHTML()}</a></nav><g:if test="${flash.error}"><p class="error">${flash.error.encodeAsHTML()}</p></g:if><section><p><strong>Release Status:</strong> ${dcn.status}</p><p><strong>Description:</strong> ${dcn.description?.encodeAsHTML()}</p><p><strong>Planned Release:</strong> <g:formatDate date="${dcn.plannedReleaseDate}" format="yyyy-MM-dd"/></p><g:if test="${request.isUserInRole('ROLE_ADMIN')}"><g:if test="${dcn.status == 'DRAFT'}"><form method="post" action="${g.createLink(controller:'changeManagement', action:'transition', id:dcn.id)}" class="inline"><input type="hidden" name="target" value="IN_REVIEW"/><button class="btn">Submit for Review</button></form></g:if><g:if test="${dcn.status == 'IN_REVIEW'}"><form method="post" action="${g.createLink(controller:'changeManagement', action:'transition', id:dcn.id)}" class="inline"><input type="hidden" name="target" value="DRAFT"/><button class="btn">Return to Draft</button></form><form method="post" action="${g.createLink(controller:'changeManagement', action:'transition', id:dcn.id)}" class="inline"><input type="hidden" name="target" value="APPROVED"/><button class="btn">Approve</button></form></g:if><g:if test="${dcn.status == 'APPROVED'}"><form method="post" action="${g.createLink(controller:'changeManagement', action:'transition', id:dcn.id)}" class="inline"><input type="hidden" name="target" value="RELEASED"/><button class="btn" onclick="return confirm('Release all connected part revisions?')">Release DCN and Parts</button></form></g:if></g:if><h2>Connected Parts</h2><div class="table-wrap"><table><tr><th>Part</th><th>Version</th><th>LOM</th><th>Lifecycle</th><th></th></tr><g:each in="${connectedParts}" var="link"><tr><td>${(link.part.label ?: link.part.id.toString()).encodeAsHTML()}</td><td>${link.majorVersion}.${link.minorVersion}</td><td>${link.part.lom ?: '—'}</td><td>${link.part.lifecycleState}</td><td><a class="btn" href="${g.createLink(controller:'plm', action:'showPart', id:link.part.id)}">Open Part</a><g:if test="${dcn.status == 'DRAFT' && request.isUserInRole('ROLE_ADMIN')}"><form method="post" action="${g.createLink(controller:'changeManagement', action:'removePart', id:dcn.id)}" class="inline"><input type="hidden" name="associationId" value="${link.associationId}"/><button class="btn">Remove</button></form></g:if></td></tr></g:each></table></div><g:if test="${dcn.status == 'DRAFT' && request.isUserInRole('ROLE_ADMIN')}"><h3>Add Part</h3><form method="post" action="${g.createLink(controller:'changeManagement', action:'addPart', id:dcn.id)}"><select name="partId"><g:each in="${parts}" var="p"><option value="${p.id}">${(p.label ?: p.originalName ?: p.id.toString()).encodeAsHTML()} (#${p.id})</option></g:each></select><button class="btn">Add Part</button></form></g:if></section></main></main></div><g:render template="/shared/pmScript"/></div>