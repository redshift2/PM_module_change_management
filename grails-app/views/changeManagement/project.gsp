<div class="pm-shell" data-pm-theme="dark"><g:render template="/shared/pmShellStyles"/><g:render template="/shared/pmShellSidebar"/><div class="pm-main"><g:render template="/shared/pmShellHeader" model="[moduleTitle: 'Change Management']"/><main class="pm-content"><main class="cm"><nav class="cm-nav"><a href="${g.createLink(controller:'changeManagement', action:'index', params:[tab:'projects'])}">Projects</a><a href="${g.createLink(controller:'changeManagement', action:'index')}">DCN</a></nav><section><h2>${project.title.encodeAsHTML()}</h2><p>${project.description?.encodeAsHTML()}</p><p>Status: <strong>${project.status}</strong> | Start of Production: <g:formatDate date="${project.startOfProduction}" format="yyyy-MM-dd"/></p><g:if test="${project.status == 'OPEN' && request.isUserInRole('ROLE_ADMIN')}"><form method="post" action="${g.createLink(controller:'changeManagement', action:'closeProject', id:project.id)}"><button class="btn" onclick="return confirm('Close project?')">Close Project</button></form></g:if><h2>Connected DCNs</h2><div class="table-wrap"><table><tr><th>DCN</th><th>Title</th><th>Status</th><th></th></tr><g:each in="${dcns}" var="d"><tr><td>${d.dcnNumber.encodeAsHTML()}</td><td>${d.title.encodeAsHTML()}</td><td>${d.status}</td><td><a href="${g.createLink(controller:'changeManagement', action:'dcn', id:d.id)}" class="btn">Open DCN</a></td></tr></g:each></table></div><h2>Connected Parts</h2><div class="table-wrap"><table><tr><th>Part</th><th>CAD Version</th><th>LOM</th><th>Release State</th><th>DCN</th><th></th></tr><g:each in="${links}" var="link"><tr><td>${(link.part.label ?: link.part.originalName ?: link.part.id.toString()).encodeAsHTML()}</td><td>${link.majorVersion}.${link.minorVersion}</td><td>${link.part.lom ?: '—'}</td><td>${link.part.lifecycleState}</td><td>${link.dcn.dcnNumber.encodeAsHTML()}</td><td><a class="btn" href="${g.createLink(controller:'plm', action:'showPart', id:link.part.id)}">Open Part</a></td></tr></g:each></table></div></section></main></main></div><g:render template="/shared/pmShellScript"/></div>